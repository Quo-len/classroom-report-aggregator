# Hosted deployment: Google OAuth + Supabase PostgreSQL (no Supabase SDK).
# Use the Supabase session-pooler URL from the Connect dialog, not transaction mode.
# Leave DATABASE_URL unset for the legacy single-account CLI.
DATABASE_URL=
DATABASE_CA=
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate each independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Comma-separated Google emails that are always administrators. Empty: the first account to sign in becomes admin.
ADMIN_EMAILS=
# Role for newly registered accounts: editor (default) or viewer (read-only until an admin promotes them).
DEFAULT_ROLE=editor

# Shared by hosted and CLI modes.
# Default assignment name; each hosted user can change it in their settings.
ASSIGNMENT_NAME="Інформація про науково-дослідну роботу"
# Name of the Drive folder created in each user's My Drive. It holds the "Зведені звіти" subfolder and the
# "План роботи кафедри" / "План наукової роботи кафедри" sheets, all found or created automatically.
WORKSPACE_FOLDER_NAME="Секретар кафедри"

# The remaining settings are for the legacy CLI only.
# Hosted users configure recipients and the course in the dashboard.
# Path to Google OAuth2 Client Secrets JSON file or Service Account credentials
GOOGLE_CREDENTIALS_FILE=credentials.json

# Path where Google OAuth2 access/refresh tokens will be saved and refreshed
GOOGLE_TOKEN_FILE=token.json

# Google Classroom course name (case-insensitive, partial match allowed). Leave empty if you teach exactly one course.
CLASSROOM_COURSE_NAME="Кафедра інформатики"

# Telegram Bot token for sending department notifications
TELEGRAM_BOT_TOKEN=your_bot_token

# Chat ID of the Head of Department in Telegram
HEAD_OF_DEPT_CHAT_ID=chat_id_here

# Email address of the Head of Department
HEAD_OF_DEPT_EMAIL=head@example.com

# Email address of the Scientific Department
SCI_DEPT_EMAIL=science@example.com

# Optional: Groq API Key for AI text extraction and Executive Summary generation
GROQ_API_KEY=your_groq_api_key_here
