{
  "name": "ai-bird-secretary",
  "version": "1.0.0",
  "description": "Academic Department Automation System for Google Classroom, Sheets, Gmail and Telegram",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx test/test-aggregator.ts && tsx test/test-doc-parser.ts",
    "test:parser": "tsx test/test-doc-parser.ts",
    "check": "tsx src/index.ts --healthcheck",
    "dry-run": "tsx src/index.ts --auto --dry-run",
    "auth:init": "tsx src/index.ts --auth-init"
  },
  "keywords": [
    "automation",
    "google-classroom",
    "google-sheets",
    "telegram",
    "gmail"
  ],
  "author": "Antigravity Expert Backend Team",
  "license": "ISC",
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
